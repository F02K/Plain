note: Rock, paper, scissors against the computer. The first to win three rounds wins the game.
action beats takes(a, b) do
    return (a = "rock" and b = "scissors") or (a = "paper" and b = "rock") or (a = "scissors" and b = "paper")
end

action computer_choice do
    let pick be random(1, 3)
    if pick = 1 then
        return "rock"
    else if pick = 2 then
        return "paper"
    end
    return "scissors"
end

let mine be 0
let computers be 0
say "Type rock, paper or scissors (or quit)."
while mine < 3 and computers < 3 do
    let choice be lower of trim of input "Your choice?"
    if choice = "quit" or choice = "" then
        stop
    end
    if not (choice = "rock" or choice = "paper" or choice = "scissors") then
        say "Please type rock, paper or scissors."
        skip
    end
    let other be computer_choice()
    say "The computer chose " + other + "."
    if choice = other then
        say "A draw."
    else if beats(choice, other) then
        set mine to mine + 1
        say "You win this round."
    else
        set computers to computers + 1
        say "The computer wins this round."
    end
    say "Score: you " + mine + ", computer " + computers
end

if mine = 3 then
    say "You won the game!"
else if computers = 3 then
    say "The computer won the game."
else
    say "Game stopped."
end
