note: A small ball game. Move the paddle with the left and right arrow keys.
note: Close the window to stop.

import window
import color

define Ball as
    x as number
    y as number
    speed_x as number
    speed_y as number
end

let sky be Color(red: 20, green: 24, blue: 40)
let paddle be 200
let score be 0
let lives be 3
let ball be Ball(x: 240, y: 100, speed_x: 3, speed_y: 3)

action move_paddle takes(position, amount) do
    return min(400, max(0, position + amount))
end

action bounce takes(ball) do
    set x of ball to x of ball + speed_x of ball
    set y of ball to y of ball + speed_y of ball
    if x of ball < 8 or x of ball > 472 then
        set speed_x of ball to -speed_x of ball
    end
    if y of ball < 8 then
        set speed_y of ball to -speed_y of ball
    end
end

action hits_paddle takes(ball, position) do
    return y of ball > 292 and y of ball < 310 and x of ball > position and x of ball < position + 80
end

action draw_scene takes(win, ball, position, score, lives) do
    run clear of win
    run draw_rectangle(position, 300, 80, 10, white of color) of win
    run draw_circle(x of ball, y of ball, 8, orange of color) of win
    run draw_text("Score: " + score + "   Lives: " + lives, 10, 8, white of color) of win
end

let win be Window(title: "Plain Ball", width: 480, height: 320, background: sky)

while open of win do
    if is_down("left") of win then
        set paddle to move_paddle(paddle, -6)
    end
    if is_down("right") of win then
        set paddle to move_paddle(paddle, 6)
    end

    run bounce(ball)

    if hits_paddle(ball, paddle) then
        set speed_y of ball to -abs of speed_y of ball
        set score to score + 1
    end

    note: the ball fell down
    if y of ball > 330 then
        set lives to lives - 1
        set x of ball to 240
        set y of ball to 100
        if lives = 0 then
            set lives to 3
            set score to 0
        end
    end

    run draw_scene(win, ball, paddle, score, lives)
    run show of win
end
