note: Hold the mouse button to paint. Keys 1, 2, 3 change the color, C clears the picture.
import window
import color

let pen be blue of color
let win be Window(title: "Paint", width: 640, height: 480, background: white of color)
run clear of win

while open of win do
    if is_down("1") of win then
        set pen to blue of color
    end
    if is_down("2") of win then
        set pen to red of color
    end
    if is_down("3") of win then
        set pen to green of color
    end
    if is_down("c") of win then
        run clear of win
    end

    if mouse_down of win then
        run draw_circle(mouse_x of win, mouse_y of win, 6, pen) of win
    end
    run show of win
end
