note: Windows are hidden in the tests (PLAIN_HEADLESS), so this only checks the logic.
open window "Test" with width 320 and height 200
use color 255, 0, 0
clear window
use color 0, 0, 255
draw rectangle at 10, 10 size 100 by 50
draw circle at 200, 100 radius 30
draw line from 0, 0 to 320, 200
draw text "Hello ä" at 10, 120
use color 300, -5, 0.5
let frames be 0
while window is open and frames < 5 do
    show window
    set frames to frames + 1
end
say frames
say window is open
say key "a" is pressed
say key "left" is pressed
say key "space" is pressed
say mouse x >= -1000
say mouse y < 100000
say mouse is down
try
    say key "banana" is pressed
catch error then
    say error
end
try
    open window "Second" with width 100 and height 100
catch error then
    say error
end
close window
say window is open
note: drawing after the window is closed is allowed and does nothing visible
draw rectangle at 0, 0 size 10 by 10
show window
say "done"
