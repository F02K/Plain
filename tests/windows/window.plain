note: Windows are hidden in the tests (PLAIN_HEADLESS), so this only checks the logic.
import window
import color

let win be Window(title: "Test", width: 320, height: 200)
say title of win
say width of win
say height of win
say open of win
set color of win to red of color
run clear of win
run draw_rectangle(10, 10, 100, 50, blue of color) of win
run draw_circle(200, 100, 30) of win
run draw_circle(x: 20, radius: 5, y: 40) of win
run draw_line(0, 0, 320, 200) of win
run draw_text("Hello ä", 10, 120) of win
let frames be 0
while open of win and frames < 5 do
    run show of win
    set frames to frames + 1
end
say frames
say is_down("a") of win
say is_down("left") of win
say is_down("space") of win
say mouse_x of win >= -1000
say mouse_y of win < 100000
say mouse_down of win
try
    say is_down("banana") of win
catch error then
    say error
end
try
    let second be Window(title: "Second", width: 100, height: 100)
catch error then
    say error
end
try
    set width of win to 500
catch error then
    say error
end
run close of win
say open of win
note: drawing after the window is closed is allowed and does nothing visible
run draw_rectangle(0, 0, 10, 10) of win
run show of win
say "done"
