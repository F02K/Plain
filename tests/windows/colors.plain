note: Colors are checked without showing anything (PLAIN_HEADLESS).
import window

let sky be Color(red: 20, green: 24, blue: 40)
open window "Colors" with width 200 and height 100
clear window with color sky
use color orange
draw circle at 50, 50 radius 10
use color sky
draw rectangle at 0, 0 size 5 by 5
clear window with color black
set green of sky to 99
use color sky
say red of sky + green of sky + blue of sky
let r be 10
use color r, r * 2, 30
show window
close window
say "ok"
