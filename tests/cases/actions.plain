action fact takes(n) do
    if n <= 1 then
        return 1
    end
    return n * fact(n - 1)
end

action double takes(x) do
    return x + x
end

action greet takes(name) do
    say "Hello " + name
end

action fib takes(n) do
    if n < 2 then
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

say fact(10)
say double(21)
say double("ab")
do greet("Max")
say fib(20)
say double(fact(3)) + 1
